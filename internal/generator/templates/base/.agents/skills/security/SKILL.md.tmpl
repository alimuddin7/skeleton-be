## 4. RSA Signature Verification
Use this snippet to verify asymmetric signatures using a public key:

```go
package security

import (
	"crypto"
	"crypto/rsa"
	"crypto/sha256"
	"crypto/x509"
	"encoding/pem"
	"errors"
)

// VerifyRSASignature verifies a SHA256 hashed signature using a PEM encoded RSA Public Key
func VerifyRSASignature(pemPublicKey []byte, message, signature []byte) error {
	block, _ := pem.Decode(pemPublicKey)
	if block == nil {
		return errors.New("failed to parse PEM public key")
	}
	pub, err := x509.ParsePKIXPublicKey(block.Bytes)
	if err != nil {
		return err
	}
	rsaPub, ok := pub.(*rsa.PublicKey)
	if !ok {
		return errors.New("not an RSA public key")
	}
	
	hash := sha256.New()
	hash.Write(message)
	hashed := hash.Sum(nil)

	return rsa.VerifyPKCS1v15(rsaPub, crypto.SHA256, hashed, signature)
}
```
