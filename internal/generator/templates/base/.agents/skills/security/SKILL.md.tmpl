## 3. HMAC-SHA512 Signature Verification
Use this snippet to verify requests signed with HMAC-SHA512:

```go
package security

import (
	"crypto/hmac"
	"crypto/sha512"
	"crypto/subtle"
)

// GenerateHMAC512 creates an HMAC-SHA512 hash of the message using a secret key
func GenerateHMAC512(message, secret []byte) []byte {
	h := hmac.New(sha512.New, secret)
	h.Write(message)
	return h.Sum(nil)
}

// VerifyHMAC512 checks if the received signature matches the message and secret key
func VerifyHMAC512(message, secret, receivedSignature []byte) bool {
	expectedSig := GenerateHMAC512(message, secret)
	return subtle.ConstantTimeCompare(expectedSig, receivedSignature) == 1
}
```

