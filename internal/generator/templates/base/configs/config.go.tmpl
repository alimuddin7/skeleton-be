package configs

import (
	"log"
	"time"
	"github.com/joho/godotenv"
	"github.com/kelseyhightower/envconfig"
)

type Config struct {
	General struct {
		ServiceName         string        `envconfig:"SERVICE_NAME" required:"true"`
		SecretKey           string        `envconfig:"SECRET_KEY" required:"true"`
		MaxIdleConns        int           `envconfig:"MAX_IDLE_CONNS" default:"100"`
		MaxIdleConnsPerHost int           `envconfig:"MAX_IDLE_CONNS_PER_HOST" default:"20"`
		IdleConnTimeout     time.Duration `envconfig:"IDLE_CONN_TIMEOUT" default:"90s"`
	}
	Server struct {
		Address    string `envconfig:"ROUTER_SERVER_ADDRESS" default:"0.0.0.0"`
		Port       string `envconfig:"ROUTER_PORT" default:"3000"`
		MainPath   string `envconfig:"PATH_MAIN" default:"/api"`
		SetMode    string `envconfig:"ROUTER_SETMODE" default:"debug"`
		MaxTimeout string `envconfig:"MAX_TIMEOUT" default:"30s"`
	}
	{{- if .Hosts}}
	Hosts     Hosts     `envconfig:"HOSTS"`
	{{- end}}

	{{- if .Modules}}
	Database struct {
		{{- range .Modules}}
		{{- if eq . "mysql"}}
		MySQL      struct { Host string `envconfig:"MYSQL_HOST"`; Port int `envconfig:"MYSQL_PORT"`; User string `envconfig:"MYSQL_USER"`; Pass string `envconfig:"MYSQL_PASS"`; Database string `envconfig:"MYSQL_DB"`; MaxConn int `envconfig:"MYSQL_MAX_CONN"`; MaxIdleConn int `envconfig:"MYSQL_MAX_IDLE_CONN"`; ConnMaxIdleTime time.Duration `envconfig:"MYSQL_CONN_MAX_IDLE_TIME"`; ConnMaxLifetime time.Duration `envconfig:"MYSQL_CONN_MAX_LIFETIME"` }
		{{- end}}
		{{- if eq . "postgresql"}}
		PostgreSQL struct { Host string `envconfig:"POSTGRE_HOST"`; Port int `envconfig:"POSTGRE_PORT"`; User string `envconfig:"POSTGRE_USER"`; Pass string `envconfig:"POSTGRE_PASS"`; Database string `envconfig:"POSTGRE_DB"`; SSLMode string `envconfig:"POSTGRE_SSL"`; MaxConn int `envconfig:"POSTGRE_MAX_CONN"`; MaxIdleConn int `envconfig:"POSTGRE_MAX_IDLE_CONN"`; ConnMaxIdleTime time.Duration `envconfig:"POSTGRE_CONN_MAX_IDLE_TIME"`; ConnMaxLifetime time.Duration `envconfig:"POSTGRE_CONN_MAX_LIFETIME"` }
		{{- end}}
		{{- if eq . "redis"}}
		Redis      struct { Address string `envconfig:"REDIS_ADDRESS"`; Port int `envconfig:"REDIS_PORT"`; Password string `envconfig:"REDIS_PASSWORD"`; DBType int `envconfig:"REDIS_DB_TYPE"` }
		{{- end}}
		{{- if eq . "kafka"}}
		Kafka      struct { Address string `envconfig:"KAFKA_ADDRESS"`; GroupID string `envconfig:"KAFKA_GROUP_ID"` }
		{{- end}}
		{{- if eq . "nats"}}
		Nats       struct {
			Servers         []string `envconfig:"NATS_SERVERS"`
			Username        string   `envconfig:"NATS_USERNAME"`
			Password        string   `envconfig:"NATS_PASSWORD"`
			ExampleStream   string   `envconfig:"NATS_EXAMPLE_STREAM" default:"EXAMPLE_STREAM"`
			ExampleConsumer string   `envconfig:"NATS_EXAMPLE_CONSUMER" default:"EXAMPLE_CONSUMER"`
			ExampleSubject  string 	 `envconfig:"NATS_EXAMPLE_SUBJECT" default:"EXAMPLE_CONSUMER"`
		}
		{{- end}}
		{{- if eq . "asynq"}}
		Asynq      struct { RedisAddr string `envconfig:"ASYNQ_REDIS_ADDR" default:"localhost:6379"`; RedisPassword string `envconfig:"ASYNQ_REDIS_PASSWORD"`; DBIndex int `envconfig:"ASYNQ_REDIS_DB" default:"0"`; Concurrency int `envconfig:"ASYNQ_CONCURRENCY" default:"10"` }
		{{- end}}
		{{- if eq . "minio"}}
		Minio      struct { Endpoint string `envconfig:"MINIO_ENDPOINT"`; KeyID string `envconfig:"MINIO_KEY_ID"`; Secret string `envconfig:"MINIO_SECRET"`; Domain string `envconfig:"MINIO_DOMAIN"` }
		{{- end}}
		{{- if eq . "redis-cluster"}}
		RedisCluster struct { Address []string `envconfig:"REDIS_CLUSTER_ADDRESS"`; SlaveAddress []string `envconfig:"REDIS_CLUSTER_SLAVE_ADDRESS"` }
		{{- end}}
		{{- end}}
	}
	{{- end}}
	{{- if has .ProjectTypes "Scheduler"}}
	Scheduler struct {
		TaskTime string `envconfig:"SCHEDULER_TASK_TIME" default:"0 0 * * * *"`
	}
	{{- end}}
	{{- if or (has .Modules "grpc-server") (has .Modules "grpc-client")}}
	GRPC struct {
		{{- if has .Modules "grpc-server"}}
		ServerPort string `envconfig:"GRPC_SERVER_PORT" default:"50051"`
		{{- end}}
		{{- if has .Modules "grpc-client"}}
		ClientAddr string `envconfig:"GRPC_CLIENT_ADDR" default:"localhost:50051"`
		{{- end}}
	}
	{{- end}}
}

{{if .Hosts}}
type Hosts struct {
	{{- range .Hosts}}
	{{. | title}} {{. | title}}Host `envconfig:"{{. | upper_snake}}"`
	{{- end}}
}
{{end}}

{{- range .Hosts}}
type {{. | title}}Host struct {
	Host       string        `envconfig:"HOST"`
	Get        string        `envconfig:"GET"`
	Post       string        `envconfig:"POST"`
	Timeout    time.Duration `envconfig:"TIMEOUT"`
	MaxRetry   int           `envconfig:"MAX_RETRY" default:"3"`
	RetryDelay time.Duration `envconfig:"RETRY_DELAY" default:"2s"`
}
{{- end}}

var Cfg Config

func LoadConfig() {
	_ = godotenv.Load(".env")
	if err := envconfig.Process("", &Cfg); err != nil {
		log.Fatalf("Failed to load from ENV: %v", err)
	}
}
