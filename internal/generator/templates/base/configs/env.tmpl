SERVICE_NAME={{.ProjectName}}
SERVICE_CODE={{.ServiceCode}}
LOG_NAME=./logs/{{.ProjectName}}.log
LOG_LEVEL=debug

ROUTER_PORT=7878
PATH_MAIN=/{{.ProjectName}}
SECRET_KEY=secretkey
MAX_IDLE_CONNS=100
MAX_IDLE_CONNS_PER_HOST=20
IDLE_CONN_TIMEOUT=90s
GOMAXPROCS=
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_IDLE_TIMEOUT=30s
SERVER_SHUTDOWN_TIMEOUT=10s

{{- range .Modules}}
{{- if eq . "postgresql"}}
# POSTGRES
POSTGRE_HOST=localhost
POSTGRE_PORT=5432
POSTGRE_USER=postgres
POSTGRE_PASS=password
POSTGRE_DB=db_name
POSTGRE_SSL=disable
# POSTGRES LIMITS & TIMEOUTS
POSTGRE_MAX_CONN=
POSTGRE_MAX_IDLE_CONN=
POSTGRE_MAX_CONN_WAIT=
POSTGRE_MAX_CONN_IDLE_TIME=
{{- end}}
{{- if eq . "mysql"}}
# MYSQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=password
MYSQL_DB=db_name
# MYSQL LIMITS & TIMEOUTS
MYSQL_MAX_CONN=
MYSQL_MAX_IDLE_CONN=
MYSQL_MAX_CONN_WAIT=
MYSQL_MAX_CONN_IDLE_TIME=
{{- end}}
{{- if eq . "redis"}}
# REDIS
REDIS_ADDRESS=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_TYPE=0
{{- end}}
{{- if eq . "kafka"}}
# KAFKA
KAFKA_ADDRESS=localhost:9092
KAFKA_GROUP_ID=my-group
{{- end}}
{{- if eq . "nats"}}
# NATS
NATS_SERVERS=nats://localhost:4222
NATS_USERNAME=
NATS_PASSWORD=
{{- end}}
{{- if eq . "minio"}}
# MINIO
MINIO_ENDPOINT=localhost:9000
MINIO_KEY_ID=minioadmin
MINIO_SECRET=minioadmin
MINIO_DOMAIN=http://localhost:9000
{{- end}}
{{- if eq . "redis-cluster"}}
# REDIS CLUSTER
REDIS_CLUSTER_ADDRESS=localhost:7000,localhost:7001,localhost:7002
REDIS_CLUSTER_SLAVE_ADDRESS=localhost:7003,localhost:7004,localhost:7005
{{- end}}
{{- end}}

{{- if has .ProjectTypes "Scheduler"}}
# SCHEDULER
SCHEDULER_TASK_TIME="0 0 * * * *"
{{- end}}

{{- if or (has .Modules "grpc-server") (has .Modules "grpc-client")}}
# GRPC
GRPC_SERVER_PORT=50051
GRPC_CLIENT_ADDRESS=localhost:50051
{{- end}}

{{- range .Hosts}}
# Hosts
HOSTS_{{. | upper_snake}}_HOST=http://localhost:8080
HOSTS_{{. | upper_snake}}_GET=/api/v1/resource
HOSTS_{{. | upper_snake}}_POST=/api/v1/resource
HOSTS_{{. | upper_snake}}_TIMEOUT=30s
HOSTS_{{. | upper_snake}}_MAX_RETRY=3
HOSTS_{{. | upper_snake}}_RETRY_DELAY=2s
{{- end}}
