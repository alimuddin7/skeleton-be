package consumers

import (
	"context"
	"{{.ProjectName}}/constants"
	v1Usecases "{{.ProjectName}}/usecases/v1"

	{{- if has .Modules "nats-consumer"}}
	natsgo "github.com/nats-io/nats.go/jetstream"
	{{- end}}
	{{- if has .Modules "asynq-consumer"}}
	"github.com/hibiken/asynq"
	{{- end}}
	{{- if has .Modules "kafka-consumer"}}
	"github.com/twmb/franz-go/pkg/kgo"
	{{- end}}
	"github.com/google/uuid"
	"github.com/rs/zerolog"
)

type consumer struct {
	logs    zerolog.Logger
	usecase v1Usecases.Usecase
}

type Consumer interface {
	{{- if has .Modules "nats-consumer"}}
	ConsumeNats(msg natsgo.Msg)
	{{- end}}
	{{- if has .Modules "kafka-consumer"}}
	ConsumeKafka(record *kgo.Record) error
	{{- end}}
	{{- if has .Modules "asynq-consumer"}}
	ProcessTask(ctx context.Context, t *asynq.Task) error
	{{- end}}
}

func NewConsumer(logs zerolog.Logger, usecase v1Usecases.Usecase) Consumer {
	return &consumer{
		logs:    logs,
		usecase: usecase,
	}
}

{{- if has .Modules "nats-consumer"}}

func (c *consumer) ConsumeNats(msg natsgo.Msg) {
	traceID := msg.Headers().Get("X-Trace-ID")
	if traceID == "" {
		traceID = uuid.New().String()
	}

	ctx := context.WithValue(context.Background(), constants.TRANSACTION_ID, traceID)
	c.logs.Info().Ctx(ctx).Msgf("[NATS] Received: %v | %s", msg.Headers(), string(msg.Data()))

	if err := msg.Ack(); err != nil {
		c.logs.Error().Ctx(ctx).Err(err).Msg("[NATS] Failed to ack message")
	}
}
{{- end}}

{{- if has .Modules "kafka-consumer"}}

func (c *consumer) ConsumeKafka(record *kgo.Record) error {
	var traceID string
	for _, header := range record.Headers {
		if header.Key == "X-Trace-ID" {
			traceID = string(header.Value)
			break
		}
	}
	if traceID == "" {
		traceID = uuid.New().String()
	}

	ctx := context.WithValue(context.Background(), constants.TRANSACTION_ID, traceID)
	c.logs.Info().Ctx(ctx).Msgf("[Kafka] Received: %s", string(record.Value))
	
	// TODO: implement Kafka message processing
	return nil
}
{{- end}}

