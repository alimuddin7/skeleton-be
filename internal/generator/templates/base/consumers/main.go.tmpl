package consumers

import (
	"context"
	{{- if or (has .Modules "nats-consumer") (has .Modules "asynq-consumer") (has .Modules "kafka-consumer")}}
	"{{.ProjectName}}/configs"
	{{- end}}
	"{{.ProjectName}}/repositories"
	{{- if has .Modules "nats-consumer"}}
	natsgo "github.com/nats-io/nats.go/jetstream"
	{{- end}}
	{{- if has .Modules "kafka-consumer"}}
	"github.com/twmb/franz-go/pkg/kgo"
	{{- end}}
	{{- if has .Modules "asynq-consumer"}}
	"github.com/hibiken/asynq"
	{{- end}}
	"github.com/rs/zerolog"
)

{{- if has .Modules "nats-consumer"}}
// NatsConsumerConfig mendefinisikan konfigurasi masing-masing NATS consumer
type NatsConsumerConfig struct {
	StreamName   string
	SubjectName  string
	Handler      natsgo.MessageHandler
}
{{- end}}

{{- if has .Modules "kafka-consumer"}}
// KafkaConsumerConfig mendefinisikan konfigurasi masing-masing Kafka consumer
type KafkaConsumerConfig struct {
	Topic   string
	Handler func(*kgo.Record) error
}
{{- end}}

// InitializeConsumers registers all message consumers for the application
func InitializeConsumers(ctx context.Context, repo repositories.Repository, c Consumer, l zerolog.Logger) {
	l.Info().Ctx(ctx).Msg("Starting consumers...")

	{{- if has .Modules "nats-consumer"}}
	// --- NATS JetStream Consumers ---
	consumerName := configs.Cfg.General.ServiceName
	natsConsumers := []NatsConsumerConfig{
		// {
		// 	  StreamName:  configs.Cfg.Database.Nats.ExampleStream,
		//	  SubjectName: configs.Cfg.Database.Nats.ExampleConsumer,
		//	  Handler:     c.ConsumeNats,
		// },
	}
	for _, conf := range natsConsumers {
		_, err := repo.GetNats().Consume(
			ctx,
			conf.StreamName,
			conf.SubjectName,
			consumerName,
			0,
			conf.Handler,
		)
		if err != nil {
			l.Error().Ctx(ctx).Err(err).Msgf("[NATS] Failed to start consumer [%s] for stream [%s]", conf.SubjectName, conf.StreamName)
		} else {
			l.Info().Ctx(ctx).Msgf("[NATS] Consumer started [%s] -> [%s]", conf.StreamName, conf.SubjectName)
		}
	}
	{{- end}}

	{{- if has .Modules "kafka-consumer"}}
	// --- Kafka Consumers ---
	l.Info().Ctx(ctx).Msg("[Kafka] Starting Kafka consumers...")
	
	kafkaConsumers := []KafkaConsumerConfig{
		// {
		// 	Topic:   "example-topic",
		// 	Handler: c.ConsumeKafka,
		// },
	}

	for _, conf := range kafkaConsumers {
		go func(conf KafkaConsumerConfig) {
			for {
				// Assuming GetKafka().GetConsumer() returns a *kgo.Client
				fetches := repo.GetKafka().GetConsumer().PollFetches(ctx)
				if errs := fetches.Errors(); len(errs) > 0 {
					l.Error().Ctx(ctx).Msgf("[Kafka] Errors polling fetches for topic %s: %v", conf.Topic, errs)
				}

				fetches.EachRecord(func(record *kgo.Record) {
					if record.Topic == conf.Topic {
						if err := conf.Handler(record); err != nil {
							l.Error().Ctx(ctx).Err(err).Msgf("[Kafka] Error consuming record from topic %s", conf.Topic)
						}
					}
				})
			}
		}(conf)
	}
	{{- end}}

	{{- if has .Modules "asynq-consumer"}}
	// --- Asynq Workers ---
	l.Info().Ctx(ctx).Msg("[Asynq] Starting Asynq workers...")
	
	mux := asynq.NewServeMux()
	
	// Register handlers.
	// You can register specific methods for different task types.
	mux.HandleFunc("example:task", func(ctx context.Context, t *asynq.Task) error {
		return c.ProcessTask(ctx, t)
	})

	go func() {
		if err := repo.GetAsynq().GetServer().Run(mux); err != nil {
			l.Error().Err(err).Msg("[Asynq] Server failed")
		}
	}()
	{{- end}}
}
