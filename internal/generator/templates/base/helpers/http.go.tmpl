// --- Response Formatting Section ---

// ResponseFormatter formats standard API responses
func ResponseFormatter[T any](c fiber.Ctx, res dto.Response[T], err error, lang string) error {
	var resKey string

	if err != nil {
		resKey = MapErrorResponse(err)
		// Reset data and pagination when error occurs to maintain clean response
		res.Data = *new(T)
		res.Count = 0
		res.Page = nil
	} else {
		resKey = constants.RES_SUCCESS
	}

	newMeta := GetNewMetaResponse(lang, resKey)
	if res.Meta.Message != "" {
		newMeta.Message = res.Meta.Message
	}
	res.Meta = newMeta

	// Add trace ID to response header
	traceID := c.Locals(constants.TRANSACTION_ID)
	if traceID != nil {
		c.Set("X-Trace-ID", fmt.Sprintf("%v", traceID))
	}

	return c.Status(MapStatusCode(res.Meta)).JSON(res)
}

// --- HTTP Client Section ---

// HTTPClient interface for making HTTP requests
type HTTPClient interface {
	Do(ctx context.Context, method, url string, headers map[string]string, body interface{}, maxRetry int, retryDelay time.Duration) ([]byte, int, error)
	DoMultipart(ctx context.Context, method, url string, headers map[string]string, files map[string]string, fields map[string]string, maxRetry int, retryDelay time.Duration) ([]byte, int, error)
}

type httpClient struct {
	client *http.Client
	log    zerolog.Logger
}

func NewHTTPClient(maxIdleConns, maxIdleConnsPerHost int, idleConnTimeout time.Duration, logger zerolog.Logger) HTTPClient {
	// Inherit robust defaults from http.DefaultTransport (e.g., proper DialContext, KeepAlive, HTTP/2, TLS settings)
	transport, ok := http.DefaultTransport.(*http.Transport)
	if !ok {
		// Fallback if DefaultTransport is somehow overridden
		transport = &http.Transport{}
	}
	t := transport.Clone()

	// Customize our connection pool
	t.MaxIdleConns = maxIdleConns
	t.MaxIdleConnsPerHost = maxIdleConnsPerHost
	t.IdleConnTimeout = idleConnTimeout

	// OPTIONAL FIX FOR K8S DNS 5s TIMEOUT BUG:
	// If the 5s delay is caused by IPv6 (AAAA) DNS query dropping in K8s conntrack,
	// you can force IPv4 dialing by uncommenting the block below:

	dialer := &net.Dialer{
		Timeout:   30 * time.Second,
		KeepAlive: 30 * time.Second,
	}
	t.DialContext = func(ctx context.Context, network, addr string) (net.Conn, error) {
		// Force "tcp4" to avoid parallel AAAA DNS lookups
		return dialer.DialContext(ctx, "tcp4", addr)
	}

	return &httpClient{
		client: &http.Client{
			Transport: t,
			Timeout:   0, // It's recommended to rely on `ctx` timeout or set a global timeout here
		},
		log: logger,
	}
}

// Do performs a standard HTTP request with retry logic
func (h *httpClient) Do(ctx context.Context, method, url string, headers map[string]string, body interface{}, maxRetry int, retryDelay time.Duration) (respBody []byte, statusCode int, err error) {
	start := time.Now()
	var lastErr error

	defer func() {
		log := h.log
		if ctxLog := zerolog.Ctx(ctx); ctxLog.GetLevel() != zerolog.Disabled {
			log = *ctxLog
		}

		event := log.Info().Ctx(ctx)
		if err != nil {
			event = log.Error().Ctx(ctx).Err(err)
		}

		event.
			Str("method", method).
			Str("url", url).
			Any("requestHeader", headers).
			Any("requestBody", body).
			Int("status", statusCode).
			Str("timestamp", start.Format(time.RFC3339)).
			Dur("duration", time.Since(start))

		if len(respBody) > 0 {
			event.RawJSON("responseBody", respBody)
		}

		event.Msg("External API Request")
	}()

	for attempt := 0; attempt <= maxRetry; attempt++ {
		var reqBody io.Reader
		if body != nil {
			jsonBody, err := json.Marshal(body)
			if err != nil {
				return nil, 0, fmt.Errorf("failed to marshal body: %w", err)
			}
			reqBody = bytes.NewBuffer(jsonBody)
		}

		req, err := http.NewRequestWithContext(ctx, method, url, reqBody)
		if err != nil {
			return nil, 0, fmt.Errorf("failed to create request: %w", err)
		}

		for k, v := range headers {
			req.Header.Set(k, v)
		}

		if body != nil && req.Header.Get("Content-Type") == "" {
			req.Header.Set("Content-Type", "application/json")
		}

		resp, err := h.client.Do(req)
		if err == nil {
			statusCode = resp.StatusCode
			respBody, err = io.ReadAll(resp.Body)
			resp.Body.Close()

			if err == nil {
				return respBody, statusCode, nil // Success
			}
			lastErr = fmt.Errorf("failed to read response body: %w", err)
		} else {
			lastErr = fmt.Errorf("request failed: %w", err)
		}

		// Retry only if there's an error (network error or body read error)
		if attempt < maxRetry {
			select {
			case <-ctx.Done():
				return nil, statusCode, ctx.Err()
			case <-time.After(retryDelay):
				// Wait and retry
			}
		}
	}

	err = fmt.Errorf("request failed after %d attempts: %w", maxRetry+1, lastErr)
	return
}

// DoMultipart performs a multipart HTTP request with retry logic
func (h *httpClient) DoMultipart(ctx context.Context, method, url string, headers map[string]string, files map[string]string, fields map[string]string, maxRetry int, retryDelay time.Duration) (respBody []byte, statusCode int, err error) {
	start := time.Now()
	var lastErr error

	defer func() {
		log := h.log
		if ctxLog := zerolog.Ctx(ctx); ctxLog.GetLevel() != zerolog.Disabled {
			log = *ctxLog
		}

		event := log.Info().Ctx(ctx)
		if err != nil {
			event = log.Error().Ctx(ctx).Err(err)
		}

		event.
			Str("method", method).
			Str("url", url).
			Any("requestHeader", headers).
			Any("requestFiles", files).
			Any("requestFields", fields).
			Int("status", statusCode).
			Str("timestamp", start.Format(time.RFC3339)).
			Dur("duration", time.Since(start))

		if len(respBody) > 0 {
			event.RawJSON("responseBody", respBody)
		}

		event.Msg("External API Multipart Request")
	}()

	for attempt := 0; attempt <= maxRetry; attempt++ {
		reqBody := &bytes.Buffer{}
		writer := multipart.NewWriter(reqBody)

		var writeErr error
		for key, path := range files {
			file, err := os.Open(path)
			if err != nil {
				writeErr = fmt.Errorf("failed to open file %s: %w", path, err)
				break
			}

			part, err := writer.CreateFormFile(key, filepath.Base(path))
			if err != nil {
				file.Close()
				writeErr = fmt.Errorf("failed to create form file: %w", err)
				break
			}
			_, err = io.Copy(part, file)
			file.Close()
			if err != nil {
				writeErr = fmt.Errorf("failed to copy file content: %w", err)
				break
			}
		}

		if writeErr != nil {
			return nil, 0, writeErr
		}

		for key, val := range fields {
			_ = writer.WriteField(key, val)
		}

		err := writer.Close()
		if err != nil {
			return nil, 0, fmt.Errorf("failed to close writer: %w", err)
		}

		req, err := http.NewRequestWithContext(ctx, method, url, reqBody)
		if err != nil {
			return nil, 0, fmt.Errorf("failed to create request: %w", err)
		}

		req.Header.Set("Content-Type", writer.FormDataContentType())
		for k, v := range headers {
			req.Header.Set(k, v)
		}

		resp, err := h.client.Do(req)
		if err == nil {
			statusCode = resp.StatusCode
			respBody, err = io.ReadAll(resp.Body)
			resp.Body.Close()

			if err == nil {
				return respBody, statusCode, nil // Success
			}
			lastErr = fmt.Errorf("failed to read response body: %w", err)
		} else {
			lastErr = fmt.Errorf("request failed: %w", err)
		}

		if attempt < maxRetry {
			select {
			case <-ctx.Done():
				return nil, statusCode, ctx.Err()
			case <-time.After(retryDelay):
				// Wait and retry
			}
		}
	}

	err = fmt.Errorf("request failed after %d attempts: %w", maxRetry+1, lastErr)
	return
}

// --- Meta / Error Codes Section ---

var (
	metaData map[string]map[string]dto.MetaData
	once     sync.Once
)

func loadErrorCodes() {
	once.Do(func() {
		metaData = make(map[string]map[string]dto.MetaData)

		// Load from errorcodes directory
		files, _ := filepath.Glob("errorcodes/errorcodes-*.json")
		if len(files) == 0 {
			files = []string{"errorcodes.json"}
		}

		for _, file := range files {
			lang := extractLanguageCode(file)
			data, err := os.ReadFile(file)
			if err != nil {
				continue
			}

			var tempData []models.ErrorCodeElement
			if err := json.Unmarshal(data, &tempData); err != nil {
				continue
			}

			langMap := make(map[string]dto.MetaData)
			for _, entry := range tempData {
				langMap[entry.Key] = entry.Content
			}
			metaData[lang] = langMap
		}
	})
}

func extractLanguageCode(filename string) string {
	base := filepath.Base(filename)
	if base == "errorcodes.json" {
		return "en"
	}
	parts := strings.Split(base, "-")
	if len(parts) < 2 {
		return "en"
	}
	lang := strings.TrimSuffix(parts[1], filepath.Ext(parts[1]))
	return lang
}

func GetMetaResponse(key string) dto.MetaData {
	return GetNewMetaResponse("en", key)
}

func GetNewMetaResponse(lang, key string) dto.MetaData {
	loadErrorCodes()

	if lang == "" {
		lang = "en"
	}

	serviceCode := constants.SERVICE_CODE
	if langData, exists := metaData[lang]; exists {
		if response, found := langData[key]; found {
			response.Code = strings.Replace(response.Code, "?", serviceCode, 1)
			response.Message = fmt.Sprintf("%s (%s)", response.Message, response.Code)
			return response
		}
	}

	if lang != "en" {
		if enData, exists := metaData["en"]; exists {
			if response, found := enData[key]; found {
				response.Code = strings.Replace(response.Code, "?", serviceCode, 1)
				response.Message = fmt.Sprintf("%s (%s)", response.Message, response.Code)
				return response
			}
		}
	}

	return dto.MetaData{
		Code:    fmt.Sprintf("500%v00", serviceCode),
		Title:   "Error",
		Message: fmt.Sprintf("General error (500%v00)", serviceCode),
	}
}

// MapStatusCode maps meta code to HTTP status code
func MapStatusCode(metaCode dto.MetaData) int {
	switch {
	case strings.HasPrefix(metaCode.Code, "200"):
		return http.StatusOK
	case strings.HasPrefix(metaCode.Code, "202"):
		return http.StatusAccepted
	case strings.HasPrefix(metaCode.Code, "400"):
		return http.StatusBadRequest
	case strings.HasPrefix(metaCode.Code, "401"):
		return http.StatusUnauthorized
	case strings.HasPrefix(metaCode.Code, "403"):
		return http.StatusForbidden
	case strings.HasPrefix(metaCode.Code, "404"):
		return http.StatusNotFound
	case strings.HasPrefix(metaCode.Code, "409"):
		return http.StatusConflict
	default:
		return http.StatusInternalServerError
	}
}

// MapErrorResponse maps error to response key string
func MapErrorResponse(err error) string {
	switch {
	case errors.Is(err, constants.ERR_CLIENT):
		return constants.RES_CLIENT_ERROR
	case errors.Is(err, constants.ERR_VALIDATION):
		return constants.RES_VALIDATION_ERROR
	case errors.Is(err, constants.ERR_UNAUTHORIZED):
		return constants.RES_UNAUTHORIZED_ERROR
	case errors.Is(err, constants.ERR_FORBIDDEN):
		return constants.RES_FORBIDDEN_ERROR
	case errors.Is(err, constants.ERR_NOT_FOUND), errors.Is(err, gorm.ErrRecordNotFound):
		return constants.RES_NOT_FOUND_ERROR
	case errors.Is(err, constants.ERR_GENERAL):
		return constants.RES_GENERAL_ERROR
	case errors.Is(err, constants.ERR_LIMIT_EXCEEDED):
		return constants.RES_LIMIT_EXCEEDED
	case errors.Is(err, constants.ERR_INACTIVE_CLIENT):
		return constants.RES_INACTIVE_CLIENT
	case errors.Is(err, constants.ERR_INSUFFICIENT_BALANCE):
		return constants.RES_INSUFFICIENT_BALANCE
	default:
		return constants.RES_GENERAL_ERROR
	}
}

// ErrorType helps in error formatting
type ErrorType struct{}

func (ErrorType) GetData(data interface{}, err error) string {
	return fmt.Sprintf("error get data %v : %v", data, err)
}

func (ErrorType) SaveData(data interface{}, err error) string {
	return fmt.Sprintf("error save data %v : %v", data, err)
}

