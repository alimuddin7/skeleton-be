package app

import (
	"context"
	"{{.ProjectName}}/configs"
	"{{.ProjectName}}/constants"
	"{{.ProjectName}}/controllers"
	v1Controllers "{{.ProjectName}}/controllers/v1"
	"{{.ProjectName}}/helpers"
	v1Usecases "{{.ProjectName}}/usecases/v1"

	{{- if has .ProjectTypes "Scheduler"}}
	"{{.ProjectName}}/scheduler"
	{{- end}}
	{{- if .Modules}}
	"{{.ProjectName}}/repositories"
	{{- range .Modules}}
	{{- if eq . "mysql"}}
	mysql "{{$.ProjectName}}/repositories/mysql"
	{{- end}}
	{{- if eq . "postgresql"}}
	postgre "{{$.ProjectName}}/repositories/postgre"
	{{- end}}
	{{- if eq . "redis"}}
	redis "{{$.ProjectName}}/repositories/redis"
	{{- end}}
	{{- if eq . "kafka"}}
	kafka "{{$.ProjectName}}/repositories/kafka"
	{{- end}}
	{{- if eq . "nats"}}
	nats "{{$.ProjectName}}/repositories/nats"
	{{- end}}
	{{- if eq . "asynq"}}
	asynq "{{$.ProjectName}}/repositories/asynq"
	{{- end}}
	{{- if eq . "minio"}}
	minio "{{$.ProjectName}}/repositories/minio"
	{{- end}}
	{{- if eq . "grpc-server"}}
	grpcserver "{{$.ProjectName}}/grpc/server"
	{{- end}}
	{{- if eq . "redis-cluster"}}
	rediscluster "{{$.ProjectName}}/repositories/redis_cluster"
	{{- end}}
	{{- end}}
	{{- end}}

	{{- if has .Modules "nats-consumer"}}
	"{{.ProjectName}}/consumers"
	{{- end}}
	{{- if has .Modules "kafka-consumer"}}
	"{{.ProjectName}}/consumers"
	{{- end}}
	{{- if has .Modules "asynq-consumer"}}
	"{{.ProjectName}}/consumers"
	{{- end}}

	{{- if .Hosts}}
	"{{.ProjectName}}/hosts"
	{{- range .Hosts}}
	{{. | clean}} "{{$.ProjectName}}/hosts/{{.}}"
	{{- end}}
	{{- end}}

	// [APP_IMPORT_MARKER]

	"github.com/gofiber/fiber/v3"
	"github.com/rs/zerolog"
)

// App holds all application-level dependencies.
type App struct {
	Router     fiber.Router
	Logs       zerolog.Logger
	Controller controllers.Controller
	{{- if .Modules}}
	Repo       repositories.Repository
	{{- end}}
	{{- if .Hosts}}
	Host       hosts.Host
	{{- end}}
	V1Usecase  v1Usecases.Usecase
	V1Ctrl     v1Controllers.V1Controller
	{{- if has .ProjectTypes "Scheduler"}}
	Scheduler  *scheduler.Scheduler
	{{- end}}
	{{- if has .ProjectTypes "gRPC"}}
	{{- range .Modules}}
	{{- if eq . "grpc-server"}}
	GrpcServer *grpcserver.GrpcServer
	{{- end}}
	{{- end}}
	{{- end}}
	{{- if has .Modules "nats-consumer"}}
	NatsConsumer     consumers.Consumer
	{{- end}}
	{{- if has .Modules "kafka-consumer"}}
	KafkaConsumer    consumers.Consumer
	{{- end}}
	{{- if has .Modules "asynq-consumer"}}
	AsynqConsumer    consumers.Consumer
	{{- end}}
}

// InitializeApp wires all dependencies and returns a ready-to-use App.
func InitializeApp() *App {
	configs.LoadConfig()
	logger := helpers.InitializeZeroLogs()
	startupID := helpers.GenerateTransactionID()
	startupCtx := context.WithValue(context.Background(), constants.TRANSACTION_ID, startupID)

	{{- if .Modules}}
	// --- Repositories ---
	{{- if has .Modules "nats"}}
	nc, js := nats.ConnectNats(startupCtx, logger)
	{{- end}}
	{{- if has .Modules "asynq"}}
	ac, as := asynq.ConnectAsynq(startupCtx, logger)
	{{- end}}
	repo := repositories.InitializeRepository(
		{{- range .Modules}}
		{{- if eq . "mysql"}}
		mysql.InitializeMysqlRepository(mysql.ConnectMysql(startupCtx, logger), logger),
		{{- end}}
		{{- if eq . "postgresql"}}
		postgre.InitializePostgreRepository(postgre.ConnectPostgre(startupCtx, logger), logger),
		{{- end}}
		{{- if eq . "redis"}}
		redis.InitializeRedisRepository(redis.ConnectRedis(startupCtx, logger), logger),
		{{- end}}
		{{- if eq . "kafka"}}
		kafka.InitializeKafkaRepository(kafka.ConnectKafkaReader(startupCtx, logger), kafka.ConnectKafkaWriter(startupCtx, logger), logger),
		{{- end}}
		{{- if eq . "nats"}}
		nats.InitializeNatsRepository(nc, js, logger),
		{{- end}}
		{{- if eq . "asynq"}}
		asynq.InitializeAsynqRepository(ac, as, logger),
		{{- end}}
		{{- if eq . "minio"}}
		minio.InitializeMinioRepository(minio.ConnectMinio(startupCtx, logger), logger),
		{{- end}}
		{{- if eq . "redis-cluster"}}
		rediscluster.InitializeRedisClusterRepository(rediscluster.ConnectRedisCluster(startupCtx, logger), logger),
		{{- end}}
		{{- end}}
		logger,
	)
	{{- end}}

	{{- if .Hosts}}
	// --- Hosts ---
	{{- range .Hosts}}
	{{. | clean}}Host := {{. | clean}}.Initialize{{. | title}}(logger)
	{{- end}}
	host := hosts.InitializeHost(
		{{- range .Hosts}}
		{{. | clean}}Host,
		{{- end}}
		logger,
	)
	{{- end}}
	// [APP_HOST_INIT_MARKER]

	v1Usecase := v1Usecases.InitializeV1Usecase(
		{{- if .Modules}}repo,{{end}}
		{{- if .Hosts}}host,{{end}}
		logger,
	)
	// [APP_USECASE_INIT_MARKER]

	{{- if or (has .Modules "nats-consumer") (has .Modules "kafka-consumer") (has .Modules "asynq-consumer")}}
	var consumer consumers.Consumer
	{{- if has .Modules "nats-consumer"}}
	consumer = consumers.NewConsumer(logger, v1Usecase)
	{{- end}}
	{{- if has .Modules "kafka-consumer"}}
	consumer = consumers.NewConsumer(logger, v1Usecase)
	{{- end}}
	{{- if has .Modules "asynq-consumer"}}
	consumer = consumers.NewConsumer(logger, v1Usecase)
	{{- end}}
	{{- end}}

	// --- Controllers ---
	v := v1Controllers.CustomValidator()
	v1Ctrl := v1Controllers.InitializeV1Controller(
		v1Usecase, 
		logger,
		v,
	)
	// [APP_CONTROLLER_INIT_MARKER]

	controller := controllers.InitializeController(v1Ctrl, logger)

	a := &App{
		Logs:       logger,
		Controller: controller,
		{{- if .Modules}}
		Repo:       repo,
		{{- end}}
		{{- if .Hosts}}
		Host:       host,
		{{- end}}
		V1Usecase:  v1Usecase,
		V1Ctrl:     v1Ctrl,
		{{- if has .Modules "nats-consumer"}}
		NatsConsumer:   consumer,
		{{- end}}
		{{- if has .Modules "kafka-consumer"}}
		KafkaConsumer:   consumer,
		{{- end}}
		{{- if has .Modules "asynq-consumer"}}
		AsynqConsumer:   consumer,
		{{- end}}
	}

	{{- if has .ProjectTypes "Scheduler"}}
	a.Scheduler = scheduler.InitializeScheduler(v1Usecase, logger)
	{{- end}}

	{{- if has .ProjectTypes "gRPC"}}
	{{- range .Modules}}
	{{- if eq . "grpc-server"}}
	a.GrpcServer = grpcserver.InitializeGrpcServer(v1Usecase, logger)
	{{- end}}
	{{- end}}
	{{- end}}

	return a
}
