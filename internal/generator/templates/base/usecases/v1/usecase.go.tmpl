package usecases

import (
	"context"
	{{- if has .Modules "nats"}}
	"time"
	{{- end}}
	"github.com/rs/zerolog"
	{{- if has .Modules "nats"}}
	"github.com/nats-io/nats.go"
	"github.com/nats-io/nats.go/jetstream"
	{{- end}}
	{{- if has .Modules "kafka"}}
	"github.com/twmb/franz-go/pkg/kgo"
	{{- end}}
	{{- if has .Modules "asynq"}}
	"github.com/hibiken/asynq"
	{{- end}}
	"{{.ProjectName}}/models"
	"{{.ProjectName}}/models/dto"
	"{{.ProjectName}}/helpers"
	{{- if hasDatabase .Modules}}
	"{{.ProjectName}}/repositories"
	{{- end}}
	{{- if .Hosts}}
	"{{.ProjectName}}/hosts"
	{{- end}}
	// [V1_USECASE_IMPORT_MARKER]
)

type Usecase interface {
	HealthCheck(ctx context.Context) (dto.Response[[]models.DataHealthCheck], error)
	ExampleConsumerUsecase(ctx context.Context, payload any) error
	{{- range .Routes}}
	{{. | title}}(ctx context.Context) (dto.Response[any], error)
	{{- end}}
	{{- range .Features}}
	Create{{. | title}}(ctx context.Context, req *dto.{{. | title}}Request) (dto.Response[any], error)
	Get{{. | title}}(ctx context.Context, id int) (dto.Response[dto.{{. | title}}Response], error)
	List{{. | title}}(ctx context.Context, page, limit int) (dto.Response[[]dto.{{. | title}}Response], error)
	Update{{. | title}}(ctx context.Context, id int, req *dto.{{. | title}}Request) (dto.Response[any], error)
	Delete{{. | title}}(ctx context.Context, id int) (dto.Response[any], error)
	{{- end}}
	// [V1_USECASE_INTERFACE_MARKER]
	{{- if has .Modules "nats"}}
	ExampleNatsHandler(msg jetstream.Msg)
	PublishNats(ctx context.Context, stream, subject string, ttl time.Duration, header nats.Header, data []byte) error
	{{- end}}
	{{- if has .Modules "kafka"}}
	PublishKafka(ctx context.Context, topic string, key, value []byte, headers []kgo.RecordHeader) error
	{{- end}}
	{{- if has .Modules "asynq"}}
	PublishAsynq(ctx context.Context, taskType string, payload []byte, opts ...asynq.Option) error
	{{- end}}
}

type usecase struct {
	{{- if hasDatabase .Modules}}
	Repo repositories.Repository
	{{- end}}
	{{- if .Hosts}}
	Host hosts.Host
	{{- end}}
	Logs zerolog.Logger
	// [V1_USECASE_IMPL_MARKER]
}

func InitializeV1Usecase(
	{{- if hasDatabase .Modules}}
	repo repositories.Repository,
	{{- end}}
	{{- if .Hosts}}
	h hosts.Host,
	{{- end}}
	l zerolog.Logger,
) Usecase {
	return &usecase{
		{{- if hasDatabase .Modules}}
		Repo: repo,
		{{- end}}
		{{- if .Hosts}}
		Host: h,
		{{- end}}
		Logs: l,
	}
}

func (u *usecase) HealthCheck(ctx context.Context) (dto.Response[[]models.DataHealthCheck], error) {
	var healthChecks []models.DataHealthCheck
	
	{{- if hasDatabase .Modules}}
	// Repository health checks
	{{- range .Modules}}
	{{- if eq . "mysql"}}
	healthChecks = append(healthChecks, u.Repo.GetMysql().HealthCheck(ctx))
	{{- end}}
	{{- if eq . "postgresql"}}
	healthChecks = append(healthChecks, u.Repo.GetPostgre().HealthCheck(ctx))
	{{- end}}
	{{- if eq . "redis"}}
	healthChecks = append(healthChecks, u.Repo.GetRedis().HealthCheck(ctx))
	{{- end}}
	{{- if eq . "redis-cluster"}}
	healthChecks = append(healthChecks, u.Repo.GetRedisCluster().HealthCheck(ctx))
	{{- end}}
	{{- end}}
	{{- end}}
	
	{{- if .Hosts}}
	// Host health checks
	{{- range .Hosts}}
	healthChecks = append(healthChecks, u.Host.{{. | title}}().HealthCheck(ctx))
	{{- end}}
	{{- end}}
	
	return helpers.GenerateResponseHealthCheck(healthChecks...), nil
}

func (u *usecase) ExampleConsumerUsecase(ctx context.Context, payload any) error {
	u.Logs.Info().Msg("ExampleConsumerUsecase called")
	return nil
}

{{- if has .Modules "nats"}}
func (u *usecase) ExampleNatsHandler(msg jetstream.Msg) {
	u.Logs.Info().Msgf("Received MSG via JetStream: %s", string(msg.Data()))

	if err := msg.Ack(); err != nil {
		u.Logs.Error().Err(err).Msg("Failed to ack message")
	}
}
{{- end}}
