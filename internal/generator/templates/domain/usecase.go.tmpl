func (u *usecase) List{{.FeatureName}}(ctx context.Context, page, limit int) (dto.Response[[]dto.{{.FeatureName}}Response], error) {
	offset := (page - 1) * limit
	data, count, err := u.{{.FeatureNameLower}}Repo.List(ctx, limit, offset)
	if err != nil {
		u.Logs.Error().Ctx(ctx).Err(err).Msg("Failed to list {{.FeatureNameLower}}s")
		return dto.Response[[]dto.{{.FeatureName}}Response]{}, err
	}

	totalPages := int(math.Ceil(float64(count) / float64(limit)))
	prevPage := page - 1
	if prevPage < 1 {
		prevPage = 0
	}
	nextPage := page + 1
	if nextPage > totalPages {
		nextPage = 0
	}

	var listData []dto.{{.FeatureName}}Response
	for _, v := range data {
		listData = append(listData, dto.{{.FeatureName}}Response{
			ID:   v.ID,
			Name: v.Name,
		})
	}

	return dto.Response[[]dto.{{.FeatureName}}Response]{
		Data:  listData,
		Count: count,
		Page: &dto.Page{
			CurrentPage:  page,
			PreviousPage: prevPage,
			NextPage:     nextPage,
		},
	}, nil
}

