package asynq

import (
	"context"
	"time"

	"{{.ProjectName}}/configs"
	"github.com/google/uuid"
	"github.com/hibiken/asynq"
	"github.com/rs/zerolog"
)

type AsynqRepository interface {
	GetClient() *asynq.Client
	GetServer() *asynq.Server
	// Publish enqueues a task for immediate processing
	Publish(ctx context.Context, taskType string, payload []byte, opts ...asynq.Option) (*asynq.TaskInfo, error)
	// PublishIn enqueues a task to be processed after the specified delay
	PublishIn(ctx context.Context, taskType string, payload []byte, delay time.Duration, opts ...asynq.Option) (*asynq.TaskInfo, error)
	// PublishAt enqueues a task to be processed at the specified time
	PublishAt(ctx context.Context, taskType string, payload []byte, processAt time.Time, opts ...asynq.Option) (*asynq.TaskInfo, error)
}

type asynqRepository struct {
	client *asynq.Client
	server *asynq.Server
	logs   zerolog.Logger
}

func ConnectAsynq(l zerolog.Logger) (*asynq.Client, *asynq.Server) {
	redisConn := asynq.RedisClientOpt{
		Addr:     configs.Cfg.Database.Asynq.RedisAddr,
		Password: configs.Cfg.Database.Asynq.RedisPassword,
		DB:       configs.Cfg.Database.Asynq.DBIndex,
	}

	client := asynq.NewClient(redisConn)
	server := asynq.NewServer(redisConn, asynq.Config{
		Concurrency: configs.Cfg.Database.Asynq.Concurrency,
	})

	return client, server
}

func InitializeAsynqRepository(client *asynq.Client, server *asynq.Server, l zerolog.Logger) AsynqRepository {
	return &asynqRepository{
		client: client,
		server: server,
		logs:   l,
	}
}

func (r *asynqRepository) GetClient() *asynq.Client {
	return r.client
}

func (r *asynqRepository) GetServer() *asynq.Server {
	return r.server
}

func (r *asynqRepository) Publish(ctx context.Context, taskType string, payload []byte, opts ...asynq.Option) (*asynq.TaskInfo, error) {
	start := time.Now()
	msgID := uuid.New().String()

	// Add tracing metadata via task options
	opts = append(opts,
		asynq.TaskID(msgID),
	)

	task := asynq.NewTask(taskType, payload)
	info, err := r.client.Enqueue(task, opts...)

	defer func() {
		logEvent := r.logs.Info().
			Str("task_type", taskType).
			Str("message_id", msgID).
			Str("app_id", configs.Cfg.General.ServiceName).
			Dur("duration", time.Since(start))

		if err != nil {
			logEvent.Err(err).Msg("PUBLISH ASYNQ FAILED")
		} else {
			logEvent.
				Str("task_id", info.ID).
				Str("queue", info.Queue).
				Int("max_retry", info.MaxRetry).
				Msg("PUBLISH ASYNQ")
		}
	}()

	if err != nil {
		r.logs.Error().Ctx(ctx).Err(err).
			Str("task_type", taskType).
			Str("message_id", msgID).
			Msg("Failed to enqueue asynq task")
		return nil, err
	}

	return info, nil
}

func (r *asynqRepository) PublishIn(ctx context.Context, taskType string, payload []byte, delay time.Duration, opts ...asynq.Option) (*asynq.TaskInfo, error) {
	opts = append(opts, asynq.ProcessIn(delay))
	return r.Publish(ctx, taskType, payload, opts...)
}

func (r *asynqRepository) PublishAt(ctx context.Context, taskType string, payload []byte, processAt time.Time, opts ...asynq.Option) (*asynq.TaskInfo, error) {
	opts = append(opts, asynq.ProcessAt(processAt))
	return r.Publish(ctx, taskType, payload, opts...)
}

