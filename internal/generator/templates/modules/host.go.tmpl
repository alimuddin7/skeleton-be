package {{.HostNameLower | clean}}

import (
	"context"
	"time"
	"{{.ProjectName}}/configs"
	"{{.ProjectName}}/helpers"
	"{{.ProjectName}}/models"
	"github.com/reiver/go-telnet"
	"github.com/rs/zerolog"
)

type (
	{{.HostNameTitle | untitle}} struct {
		Host          string
		EndpointGet   string
		EndpointPost  string
		Authorization string
		Log           zerolog.Logger
		Client        helpers.HTTPClient
		Timeout       time.Duration
		MaxRetry      int
		RetryDelay    time.Duration
	}

	{{.HostNameTitle}} interface {
		HealthCheck(ctx context.Context) models.DataHealthCheck
	}
)

func Initialize{{.HostNameTitle}}(log zerolog.Logger, client helpers.HTTPClient) {{.HostNameTitle}} {
	conf := configs.Cfg.Hosts.{{.HostNameTitle}}

	h := {{.HostNameTitle | untitle}}{
		Host:         conf.Host,
		EndpointGet:  conf.Get,
		EndpointPost: conf.Post,
		Timeout:      conf.Timeout,
		MaxRetry:     conf.MaxRetry,
		RetryDelay:   conf.RetryDelay,
		Log:          log,
		Client:       client,
	}

	urlSvr := helpers.TelnetIP(h.Host)
	_, err := telnet.DialTo(urlSvr)
	if err != nil {
		log.Error().Msg("Error telnet: " + urlSvr)
	} else {
		log.Info().Msg("Success telnet: " + urlSvr)
	}

	return &h
}

func (h *{{.HostNameTitle | untitle}}) HealthCheck(ctx context.Context) models.DataHealthCheck {
	urlSvr := helpers.TelnetIP(h.Host)
	res := models.DataHealthCheck{
		ServiceName: "{{.HostNameTitle}} (" + urlSvr + ")",
		StatusCode:  200,
	}

	_, err := telnet.DialTo(urlSvr)
	if err != nil {
		h.Log.Error().Ctx(ctx).Err(err).Msg("Error telnet")
		res.StatusCode = 400
		res.AdditionalData = err.Error()
	}
	return res
}
