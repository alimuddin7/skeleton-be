package nats

import (
	"context"
	"{{.ProjectName}}/configs"
	"strings"

	"github.com/nats-io/nats.go"
	"github.com/nats-io/nats.go/jetstream"
	"github.com/rs/zerolog"
)

type (
	natsRepository struct {
		Conn *nats.Conn
		JS   jetstream.JetStream
		Logs zerolog.Logger
	}
	NatsRepository interface {
		GetConn() *nats.Conn
		GetJS() jetstream.JetStream
		Publish(ctx context.Context, stream, subject string, data []byte) (*jetstream.PubAck, error)
		Consume(ctx context.Context, stream, subject, consumerName string, handler jetstream.MessageHandler) (jetstream.ConsumeContext, error)
		CreateStream(ctx context.Context, streamName string, subjects []string) (jetstream.Stream, error)
	}
)

func InitializeNatsRepository(nc *nats.Conn, js jetstream.JetStream, log zerolog.Logger) NatsRepository {
	return &natsRepository{
		Conn: nc,
		JS:   js,
		Logs: log,
	}
}

func ConnectNats(log zerolog.Logger) (*nats.Conn, jetstream.JetStream) {
	conf := configs.Cfg.Database.Nats
	nc, err := nats.Connect(strings.Join(conf.Servers, ","),
		nats.UserInfo(conf.Username, conf.Password),
		nats.MaxReconnects(-1))
	if err != nil {
		log.Error().Err(err).Msg("Failed to connect to NATS")
		panic(err)
	}

	js, err := jetstream.New(nc)
	if err != nil {
		log.Error().Err(err).Msg("Failed to initialize JetStream")
		panic(err)
	}

	log.Info().Msg("NATS connected successfully")
	return nc, js
}

func (n *natsRepository) GetConn() *nats.Conn {
	return n.Conn
}

func (n *natsRepository) GetJS() jetstream.JetStream {
	return n.JS
}

func (n *natsRepository) Publish(ctx context.Context, stream, subject string, data []byte) (*jetstream.PubAck, error) {
	// Auto create stream using subject as stream name if it doesn't exist
	_, err := n.CreateStream(ctx, stream, []string{subject})
	if err != nil {
		n.Logs.Warn().Err(err).Str("stream", stream).Msg("Failed to auto-create stream during Publish (might already exist or subject/stream mismatch)")
	}
	return n.JS.Publish(ctx, subject, data)
}

func (n *natsRepository) Consume(ctx context.Context, stream, subject, consumerName string, handler jetstream.MessageHandler) (jetstream.ConsumeContext, error) {
	// Auto create stream if it doesn't exist
	_, err := n.CreateStream(ctx, stream, []string{subject})
	if err != nil {
		n.Logs.Warn().Err(err).Str("stream", stream).Msg("Failed to auto-create stream during Consume")
	}

	cons, err := n.JS.CreateOrUpdateConsumer(ctx, stream, jetstream.ConsumerConfig{
		Durable:       consumerName,
		FilterSubject: subject,
	})
	if err != nil {
		return nil, err
	}
	return cons.Consume(handler)
}

func (n *natsRepository) CreateStream(ctx context.Context, streamName string, subjects []string) (jetstream.Stream, error) {
	return n.JS.CreateOrUpdateStream(ctx, jetstream.StreamConfig{
		Name:     streamName,
		Subjects: subjects,
	})
}
