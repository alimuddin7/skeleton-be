package rediscluster

import (
	"context"
	"{{.ProjectName}}/configs"
	"{{.ProjectName}}/models"
	"time"

	"github.com/redis/rueidis"
	"github.com/rs/zerolog"
)

type RedisClusterRepository interface {
	Get(ctx context.Context, key string) (string, error)
	Set(ctx context.Context, key, val string) error
	SetEx(ctx context.Context, key, val string, expiration time.Duration) error
	SetNX(ctx context.Context, key, val string) error
	Del(ctx context.Context, key string) error
	Incr(ctx context.Context, key string) error
	Decr(ctx context.Context, key string) error
	
	// Pub/Sub (Sharded for Cluster)
	Publish(ctx context.Context, channel, message string) error
	Subscribe(ctx context.Context, channel string, handler func(msg rueidis.PubSubMessage)) error
	
	HealthCheck(ctx context.Context) models.DataHealthCheck

	// Deprecated / Compatibility
	GetQueue(ctx context.Context, d time.Duration, key string) ([]string, error)
}

type redisClusterRepository struct {
	Client rueidis.Client
	Logs   zerolog.Logger
}

func InitializeRedisClusterRepository(conn rueidis.Client, log zerolog.Logger) RedisClusterRepository {
	return &redisClusterRepository{
		Client: conn,
		Logs:   log,
	}
}

func ConnectRedisCluster(ctx context.Context, log zerolog.Logger) rueidis.Client {
	conf := configs.Cfg.Database.RedisCluster
	
	client, err := rueidis.NewClient(rueidis.ClientOption{
		InitAddress: conf.Address,
		ShuffleInit: true,
	})

	if err != nil {
		log.Error().Ctx(ctx).Err(err).Msg("Error open redis cluster connection")
		panic("Error open redis cluster connection")
	}

	log.Info().Ctx(ctx).Msg("Redis cluster connected successfully")
	return client
}

func (r *redisClusterRepository) Get(ctx context.Context, key string) (string, error) {
	return r.Client.Do(ctx, r.Client.B().Get().Key(key).Build()).ToString()
}

func (r *redisClusterRepository) Set(ctx context.Context, key, val string) error {
	return r.Client.Do(ctx, r.Client.B().Set().Key(key).Value(val).Build()).Error()
}

func (r *redisClusterRepository) SetEx(ctx context.Context, key, val string, expiration time.Duration) error {
	return r.Client.Do(ctx, r.Client.B().Set().Key(key).Value(val).Px(expiration).Build()).Error()
}

func (r *redisClusterRepository) SetNX(ctx context.Context, key, val string) error {
	return r.Client.Do(ctx, r.Client.B().Set().Key(key).Value(val).Nx().Build()).Error()
}

func (r *redisClusterRepository) Del(ctx context.Context, key string) error {
	return r.Client.Do(ctx, r.Client.B().Del().Key(key).Build()).Error()
}

func (r *redisClusterRepository) Incr(ctx context.Context, key string) error {
	return r.Client.Do(ctx, r.Client.B().Incr().Key(key).Build()).Error()
}

func (r *redisClusterRepository) Decr(ctx context.Context, key string) error {
	return r.Client.Do(ctx, r.Client.B().Decr().Key(key).Build()).Error()
}

func (r *redisClusterRepository) Publish(ctx context.Context, channel, message string) error {
	// For clusters, Spublish (Sharded) is often preferred for performance
	return r.Client.Do(ctx, r.Client.B().Spublish().Channel(channel).Message(message).Build()).Error()
}

func (r *redisClusterRepository) Subscribe(ctx context.Context, channel string, handler func(msg rueidis.PubSubMessage)) error {
	// For clusters, Ssubscribe (Sharded) is often preferred to reduce cluster-wide broadcast
	return r.Client.Receive(ctx, r.Client.B().Ssubscribe().Channel(channel).Build(), handler)
}

func (r *redisClusterRepository) GetQueue(ctx context.Context, d time.Duration, key string) ([]string, error) {
	return r.Client.Do(ctx, r.Client.B().Brpop().Key(key).Timeout(d.Seconds()).Build()).AsStrSlice()
}

func (r *redisClusterRepository) HealthCheck(ctx context.Context) models.DataHealthCheck {
	res := models.DataHealthCheck{
		ServiceName: "Redis Cluster",
		StatusCode:  200,
	}
	
	err := r.Client.Do(ctx, r.Client.B().Ping().Build()).Error()
	if err != nil {
		r.Logs.Error().Ctx(ctx).Err(err).Msg("Redis Cluster health check failed")
		res.StatusCode = 500
		res.AdditionalData = err.Error()
		return res
	}
	
	return res
}

